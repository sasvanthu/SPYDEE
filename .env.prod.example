# SPYDEE production environment template.
# Copy to .env.prod and fill in real values, then run:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=spydee
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=spydee

# --- API security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_48_byte_token_urlsafe_value

# Comma-separated browser origins permitted to call the API directly
# (e.g. https://intel.example.gov.in). The same-origin web proxy needs no entry.
CORS_ORIGINS=https://intel.example.gov.in

# Set true to load the three synthetic demo cases + demo accounts on first run.
DEMO_MODE=false

# --- Optional LLM polish (leave LLM_PROVIDER empty for deterministic answers) --
LLM_PROVIDER=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# --- Runtime ----------------------------------------------------------------
# Published host port for the web UI (nginx serves the SPA + API proxy).
WEB_PORT=80
# Uvicorn worker processes for the API (default 1).
UVICORN_WORKERS=1
# Max uploaded evidence file size in bytes (default 50_000_000).
MAX_UPLOAD_BYTES=50000000